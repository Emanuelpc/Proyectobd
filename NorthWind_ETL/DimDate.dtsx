      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8D3E350F-D101-479B-875F-7984E06C9679}"
          SQLTask:SqlStatementSource="-- Rango de fechas basado en el periodo de transacciones de NorthWind (1996 a 1998 / ajustable)&#xA;DECLARE @StartDate DATETIME = '1996-01-01';&#xA;DECLARE @EndDate DATETIME = '1998-12-31';&#xA;&#xA;WHILE @StartDate &lt;= @EndDate&#xA;BEGIN&#xA;    IF NOT EXISTS (SELECT 1 FROM dbo.DimDate WHERE FullDate = @StartDate)&#xA;    BEGIN&#xA;        INSERT INTO dbo.DimDate (&#xA;            DateKey, &#xA;            FullDate, &#xA;            CalendarYear, &#xA;            CalendarQuarter, &#xA;            MonthNumberOfYear, &#xA;            EnglishMonthName&#xA;        )&#xA;        VALUES (&#xA;            CAST(FORMAT(@StartDate, 'yyyyMMdd') AS INT), -- Ejemplo: 19960101&#xA;            @StartDate,&#xA;            YEAR(@StartDate),&#xA;            DATEPART(QUARTER, @StartDate),&#xA;            MONTH(@StartDate),&#xA;            DATENAME(MONTH, @StartDate)&#xA;        );&#xA;    END&#xA;    SET @StartDate = DATEADD(dd, 1, @StartDate);&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
